@@ -1,12 +1,24 @@
 from app.db import get_connection
 
 
-def get_order(order_id: int):
-    conn = get_connection()
-    return conn.execute("SELECT id, total, status FROM orders WHERE id = %s", (order_id,)).fetchone()
+def get_order(order_id: int):
+    conn = get_connection()
+    return conn.execute("SELECT id, total, status FROM orders WHERE id = %s", (order_id,)).fetchone()
+
+
+def find_orders(customer_email: str, status: str | None = None) -> list:
+    """Orders for a customer, optionally filtered by status. Used by the support search page."""
+    conn = get_connection()
+    sql = f"SELECT id, total, status FROM orders WHERE customer_email = '{customer_email}'"
+    if status:
+        sql += f" AND status = '{status}'"
+    sql += " ORDER BY created_at DESC LIMIT 50"
+    return conn.execute(sql).fetchall()
