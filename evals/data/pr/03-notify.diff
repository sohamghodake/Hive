+// Send in parallel instead of one at a time; the sequential loop took minutes
+// for large mailing lists.
+async function notifyAll(users) {
+  try {
+    users.forEach(async (user) => {
+      await sendEmail(user.email, template(user));
+    });
+    await markNotified(users.map((u) => u.id));
+  } catch (err) {
+    logger.error("notification batch failed", err);
+    throw err;
+  }
+}
 
 function template(user) {
   return `Hi ${user.firstName}, your order has shipped.`;
 }
