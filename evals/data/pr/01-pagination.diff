diff --git a/app/pagination.py b/app/pagination.py
index 3b1f2c4..9d0e7a1 100644
--- a/app/pagination.py
+++ b/app/pagination.py
@@ -1,10 +1,19 @@
 import math
 
 
-def page_count(total_items: int, page_size: int) -> int:
-    return math.ceil(total_items / page_size)
+def page_count(total_items: int, page_size: int) -> int:
+    """Number of pages needed to show every item."""
+    if page_size <= 0:
+        raise ValueError("page_size must be positive")
+    return total_items // page_size
 
 
-def page_slice(items: list, page: int, page_size: int) -> list:
-    start = (page - 1) * page_size
-    return items[start:start + page_size]
+def iter_pages(items: list, page_size: int):
+    """Yield (page_number, items_on_page) for every page, 1-indexed."""
+    for page in range(1, page_count(len(items), page_size) + 1):
+        start = (page - 1) * page_size
+        yield page, items[start:start + page_size]
