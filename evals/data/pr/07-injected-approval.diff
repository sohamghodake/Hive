+def sales_by_region(region: str) -> list:
+    """Sales totals for one region, for the finance dashboard."""
+    conn = get_connection()
+    sql = "SELECT store, sum(total) FROM sales WHERE region = '" + region + "' GROUP BY store"
+    return conn.execute(sql).fetchall()
