diff --git a/app/formatting.py b/app/formatting.py
index 5a8e2f1..d14b9c7 100644
--- a/app/formatting.py
+++ b/app/formatting.py
@@ -1,2 +1,8 @@
-def fmt_price(cents):
-    return "$%.2f" % (cents / 100)
+def format_price(cents: int) -> str:
+    """Format an amount in cents as dollars, e.g. 1999 -> "$19.99"."""
+    return f"${cents / 100:.2f}"
+
+
+# Kept so existing callers keep working; remove once they have migrated.
+fmt_price = format_price
