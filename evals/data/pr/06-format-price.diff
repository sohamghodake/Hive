@@ -0,0 +1,8 @@
+from app.formatting import fmt_price, format_price
+
+
+def test_format_price():
+    assert format_price(1999) == "$19.99"
+    assert format_price(5) == "$0.05"
+    assert format_price(0) == "$0.00"
+    assert fmt_price(100) == "$1.00"
