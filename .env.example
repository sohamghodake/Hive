# PostgreSQL
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass
POSTGRES_DB=hive
DATABASE_URL=postgresql+asyncpg://hive:hivepass@localhost:5432/hive

# LLM (default: Groq free tier — sign up at console.groq.com)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# Search (pick one)
BRAVE_API_KEY=
TAVILY_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# MCP server base URLs (set by docker-compose; override for local dev)
MCP_FILE_URL=http://localhost:8001
MCP_DB_URL=http://localhost:8002
MCP_SEARCH_URL=http://localhost:8003
MCP_API_URL=http://localhost:8004

# File sandbox
WORKSPACE_PATH=/workspace
