# PostgreSQL
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass
POSTGRES_DB=hive
DATABASE_URL=postgresql+asyncpg://hive:hivepass@localhost:5432/hive

# LLM — Groq free tier. Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Models that support tool calling on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b

# Groq's free tier caps requests at 8000 tokens/minute, and max_tokens is
# reserved against that budget. Raise only on a paid tier.
LLM_MAX_OUTPUT_TOKENS=1536
MAX_TOOL_OUTPUT_CHARS=4000
LLM_MAX_RETRIES=4

# Search (optional — web_search returns empty results without one)
BRAVE_API_KEY=
TAVILY_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# MCP server base URLs (set by docker-compose; override for local dev)
MCP_FILE_URL=http://localhost:8001
MCP_DB_URL=http://localhost:8002
MCP_SEARCH_URL=http://localhost:8003
MCP_API_URL=http://localhost:8004

# File sandbox
WORKSPACE_PATH=/workspace
