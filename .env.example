# PostgreSQL
POSTGRES_USER=hive
POSTGRES_PASSWORD=hivepass
POSTGRES_DB=hive
DATABASE_URL=postgresql+asyncpg://hive:hivepass@localhost:5432/hive

# LLM — Groq free tier. Get a key at https://console.groq.com/keys
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
# Models that support tool calling on Groq: openai/gpt-oss-120b, openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-120b

# Groq's free tier caps each request at 8000 tokens/minute (prompt + max_tokens).
# Each model call requests whatever output budget is left after its prompt, up
# to LLM_MAX_OUTPUT_TOKENS. Raise LLM_TPM_BUDGET on a paid tier.
LLM_TPM_BUDGET=8000
LLM_MAX_OUTPUT_TOKENS=4096
# gpt-oss models spend output tokens on hidden reasoning; low leaves room for the answer.
LLM_REASONING_EFFORT=low
MAX_TOOL_OUTPUT_CHARS=6000
LLM_MAX_RETRIES=6

# Local embeddings (fastembed, CPU) — bounded so large uploads cannot OOM the API.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBED_BATCH_SIZE=16
EMBED_THREADS=2

# Search (optional — without a key, web_search reports that it is not configured)
BRAVE_API_KEY=
TAVILY_API_KEY=

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
SECRET_KEY=change-me-in-production

# MCP server base URLs (set by docker-compose; override for local dev)
MCP_FILE_URL=http://localhost:8001
MCP_DB_URL=http://localhost:8002
MCP_SEARCH_URL=http://localhost:8003
MCP_API_URL=http://localhost:8004

# File sandbox
WORKSPACE_PATH=/workspace
